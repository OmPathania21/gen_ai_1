# VERITAS settings. Copy this file to ".env" (same folder) and paste your own key.
# Get a free key at https://console.groq.com/keys (it starts with "gsk_").
# Never commit .env: it is in .gitignore.
GROQ_API_KEY=gsk_your_key_here

# Optional: a different Groq model
# GROQ_MODEL=openai/gpt-oss-120b   (alternatives: openai/gpt-oss-20b)
